# Required on Vercel
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
PAYLOAD_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# MySQL Database Configuration (XAMPP / Laragon / Local / Remote)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=hmi_saintek

# Required if chat is enabled
OPENROUTER_API_KEY=replace-with-openrouter-key

# Optional Supabase/public storage settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-public-publishable-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Optional operational settings
SEED_SECRET=replace-with-seed-secret
PAYLOAD_DB_PUSH=true
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_POOL_MAX=1
CMS_QUERY_TIMEOUT_MS=5000
CMS_RETRY_COOLDOWN_MS=30000
